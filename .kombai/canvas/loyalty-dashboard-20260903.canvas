        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n\n:root {\n  color-scheme: dark;\n}\n\n.shell {\n  --bg: #0a0712;\n  --bg-2: #0e0919;\n  --surface: #120c20;\n  --surface-2: #18102b;\n  --surface-3: #21153b;\n  --surface-4: #281a47;\n  --ink: #f7f4ff;\n  --ink-2: #e4dcf5;\n  --muted: #a29ab7;\n  --faint: #6f6683;\n  --line: rgba(255,255,255,.095);\n  --line-soft: rgba(255,255,255,.055);\n  --primary: #7C3AED;\n  --primary-bright: #9b6bff;\n  --primary-soft: rgba(124,58,237,.17);\n  --primary-faint: rgba(124,58,237,.08);\n  --gold: #F59E0B;\n  --gold-bright: #ffc857;\n  --gold-soft: rgba(245,158,11,.15);\n  --green: #49d7a6;\n  --green-soft: rgba(73,215,166,.12);\n  --red: #fb7185;\n  --shadow: 0 26px 80px rgba(0,0,0,.24);\n  --shadow-soft: 0 14px 40px rgba(0,0,0,.18);\n  min-height: 100vh;\n  color: var(--ink);\n  background:\n    radial-gradient(circle at 72% -12%, rgba(124,58,237,.22), transparent 34%),\n    radial-gradient(circle at 104% 45%, rgba(245,158,11,.06), transparent 28%),\n    linear-gradient(135deg, var(--bg) 0%, var(--bg-2) 46%, #0c0815 100%);\n  font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  font-size: 14px;\n  line-height: 1.45;\n  letter-spacing: -0.012em;\n  overflow: hidden;\n}\n\n.shell[data-theme=\"light\"] {\n  color-scheme: light;\n  --bg: #f7f4fb;\n  --bg-2: #fbfaff;\n  --surface: #ffffff;\n  --surface-2: #f7f3fc;\n  --surface-3: #eee8fb;\n  --surface-4: #e8defa;\n  --ink: #20152f;\n  --ink-2: #403452;\n  --muted: #736783;\n  --faint: #9d91ae;\n  --line: rgba(42,24,70,.11);\n  --line-soft: rgba(42,24,70,.065);\n  --primary-soft: rgba(124,58,237,.11);\n  --primary-faint: rgba(124,58,237,.055);\n  --gold-soft: rgba(245,158,11,.13);\n  --green-soft: rgba(16,145,108,.10);\n  --shadow: 0 22px 70px rgba(52,29,94,.12);\n  --shadow-soft: 0 12px 34px rgba(52,29,94,.09);\n  background:\n    radial-gradient(circle at 72% -12%, rgba(124,58,237,.13), transparent 34%),\n    radial-gradient(circle at 104% 45%, rgba(245,158,11,.07), transparent 28%),\n    linear-gradient(135deg, var(--bg) 0%, var(--bg-2) 52%, #f8f5ff 100%);\n}\n\n.shell button,\n.shell input {\n  font: inherit;\n}\n\n.shell button {\n  cursor: pointer;\n}\n\n.app-frame {\n  display: grid;\n  grid-template-columns: 220px minmax(0, 1fr);\n  min-height: 100vh;\n}\n\n.rail {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  padding: 26px 14px 18px;\n  background: linear-gradient(180deg, rgba(13,8,24,.92), rgba(10,7,18,.76));\n  border-right: 1px solid var(--line-soft);\n}\n\n.shell[data-theme=\"light\"] .rail {\n  background: rgba(255,255,255,.66);\n}\n\n.rail::after {\n  content: '';\n  position: absolute;\n  top: 82px;\n  right: -1px;\n  width: 1px;\n  height: 160px;\n  background: linear-gradient(180deg, transparent, var(--primary), transparent);\n  opacity: .8;\n}\n\n.rail-brand {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  padding: 0 10px 28px;\n}\n\n.brand-mark {\n  width: 35px;\n  height: 35px;\n  flex: 0 0 35px;\n  display: grid;\n  place-items: center;\n  border: 1px solid rgba(255,255,255,.18);\n  border-radius: 12px;\n  color: #fff;\n  background: linear-gradient(145deg, #a477ff, #6b28d9 56%, #3b1c82);\n  box-shadow: 0 0 0 4px rgba(124,58,237,.10), 0 10px 24px rgba(124,58,237,.33);\n}\n\n.brand-mark svg { width: 20px; height: 20px; color: #fff; }\n\n.brand-word {\n  margin: 0;\n  color: var(--ink);\n  font-size: 17px;\n  font-weight: 800;\n  letter-spacing: -.045em;\n}\n\n.brand-meta {\n  margin: 1px 0 0;\n  color: var(--faint);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n}\n\n.rail-kicker {\n  padding: 0 12px 10px;\n  color: var(--faint);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n}\n\n.nav-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.nav-item {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  width: 100%;\n  min-height: 43px;\n  padding: 9px 11px;\n  border: 1px solid transparent;\n  border-radius: 11px;\n  color: var(--muted);\n  background: transparent;\n  text-align: left;\n  transition: background .22s ease, border-color .22s ease, color .22s ease, transform .22s ease;\n}\n\n.nav-item:hover {\n  color: var(--ink-2);\n  background: var(--primary-faint);\n  border-color: var(--line-soft);\n  transform: translateX(2px);\n}\n\n.nav-item.is-active {\n  color: #fff;\n  border-color: rgba(155,107,255,.3);\n  background: linear-gradient(100deg, rgba(124,58,237,.35), rgba(124,58,237,.08));\n  box-shadow: inset 3px 0 0 var(--primary-bright), 0 8px 24px rgba(124,58,237,.14);\n}\n\n.shell[data-theme=\"light\"] .nav-item.is-active { color: #5b21b6; }\n\n.nav-icon {\n  display: grid;\n  place-items: center;\n  width: 20px;\n  height: 20px;\n  flex: 0 0 20px;\n  color: var(--faint);\n}\n\n.nav-item.is-active .nav-icon { color: var(--primary-bright); }\n.nav-item svg { width: 18px; height: 18px; }\n.nav-label { flex: 1; font-size: 12px; font-weight: 600; }\n.nav-index { color: var(--faint); font-size: 10px; font-variant-numeric: tabular-nums; }\n.nav-item.is-active .nav-index { color: rgba(255,255,255,.48); }\n.shell[data-theme=\"light\"] .nav-item.is-active .nav-index { color: rgba(91,33,182,.5); }\n\n.nav-badge {\n  display: inline-grid;\n  place-items: center;\n  min-width: 18px;\n  height: 18px;\n  padding: 0 5px;\n  border-radius: 999px;\n  color: #1f1200;\n  background: var(--gold);\n  font-size: 9px;\n  font-weight: 800;\n  box-shadow: 0 0 0 3px rgba(245,158,11,.11), 0 4px 12px rgba(245,158,11,.23);\n}\n\n.rail-spacer { flex: 1; min-height: 28px; }\n\n.rail-mini-card {\n  padding: 13px 13px 12px;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(124,58,237,.09));\n  box-shadow: var(--shadow-soft);\n}\n\n.shell[data-theme=\"light\"] .rail-mini-card {\n  background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(238,232,251,.9));\n}\n\n.rail-mini-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n.rail-mini-label { color: var(--muted); font-size: 10px; font-weight: 600; }\n.rail-mini-status { color: var(--green); font-size: 9px; font-weight: 700; }\n.rail-mini-value { margin: 7px 0 8px; color: var(--ink); font-size: 17px; font-weight: 800; letter-spacing: -.04em; }\n.mini-track { height: 4px; overflow: hidden; border-radius: 999px; background: var(--line); }\n.mini-fill { width: 72%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--primary), var(--primary-bright)); }\n.rail-version { margin: 13px 3px 0; color: var(--faint); font-size: 9px; letter-spacing: .04em; }\n\n.main-shell { min-width: 0; display: flex; flex-direction: column; }\n\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  min-height: 75px;\n  padding: 16px 38px;\n  border-bottom: 1px solid var(--line-soft);\n  background: rgba(10,7,18,.28);\n  backdrop-filter: blur(18px);\n}\n\n.shell[data-theme=\"light\"] .topbar { background: rgba(255,255,255,.42); }\n\n.business-switcher {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 210px;\n  padding: 5px 8px 5px 5px;\n  border: 1px solid transparent;\n  border-radius: 11px;\n  transition: background .2s ease, border-color .2s ease;\n}\n\n.business-switcher:hover { background: var(--primary-faint); border-color: var(--line-soft); }\n.business-logo { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; color: #fff; background: linear-gradient(145deg, #fb923c, #9a3412); box-shadow: 0 5px 16px rgba(234,88,12,.25); font-size: 10px; font-weight: 800; letter-spacing: .04em; }\n.business-copy { min-width: 0; flex: 1; }\n.business-name { margin: 0; color: var(--ink); font-size: 12px; font-weight: 700; }\n.business-location { margin: 1px 0 0; color: var(--faint); font-size: 10px; }\n.business-switcher > svg { width: 15px; height: 15px; color: var(--faint); }\n\n.topbar-actions { display: flex; align-items: center; justify-content: flex-end; gap: 9px; min-width: 0; }\n.search-box { display: flex; align-items: center; gap: 9px; width: min(315px, 31vw); height: 38px; padding: 0 10px 0 12px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255,255,255,.035); color: var(--muted); transition: border-color .22s ease, box-shadow .22s ease, background .22s ease; }\n.search-box.is-focused { border-color: var(--primary-bright); background: var(--surface-2); box-shadow: 0 0 0 4px var(--primary-soft), 0 0 28px rgba(124,58,237,.18); }\n.search-box svg { width: 16px; height: 16px; flex: 0 0 16px; color: var(--faint); }\n.search-box input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--ink); background: transparent; font-size: 11px; }\n.search-box input::placeholder { color: var(--faint); }\n.search-key { display: inline-flex; align-items: center; height: 20px; padding: 0 6px; border: 1px solid var(--line); border-radius: 5px; color: var(--faint); font-size: 9px; white-space: nowrap; }\n.icon-button { position: relative; display: grid; place-items: center; width: 38px; height: 38px; padding: 0; border: 1px solid var(--line); border-radius: 10px; color: var(--muted); background: rgba(255,255,255,.035); transition: border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease; }\n.icon-button:hover { color: var(--ink); border-color: rgba(155,107,255,.38); background: var(--primary-faint); transform: translateY(-1px); }\n.icon-button svg { width: 17px; height: 17px; }\n.notification-dot { position: absolute; top: 8px; right: 8px; width: 6px; height: 6px; border: 2px solid var(--surface); border-radius: 50%; background: var(--gold); }\n.theme-toggle { display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 10px; border: 1px solid var(--line); border-radius: 10px; color: var(--muted); background: rgba(255,255,255,.035); transition: border-color .2s ease, background .2s ease; }\n.theme-toggle:hover { border-color: rgba(155,107,255,.38); background: var(--primary-faint); }\n.theme-toggle svg { width: 15px; height: 15px; }\n.theme-toggle-label { font-size: 10px; font-weight: 600; }\n.profile-chip { display: flex; align-items: center; gap: 8px; margin-left: 3px; padding: 3px 5px 3px 3px; border: 1px solid transparent; border-radius: 10px; }\n.profile-chip:hover { border-color: var(--line); background: var(--primary-faint); }\n.avatar { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid rgba(255,255,255,.19); border-radius: 10px; color: #fff; background: linear-gradient(145deg, #c084fc, #6d28d9); font-size: 10px; font-weight: 800; }\n.profile-name { margin: 0; color: var(--ink); font-size: 11px; font-weight: 700; }\n.profile-role { margin: 1px 0 0; color: var(--faint); font-size: 9px; }\n\n.content { width: 100%; max-width: 1440px; margin: 0 auto; padding: 35px 38px 15px; }\n.hero-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 25px; }\n.eyebrow { margin: 0 0 9px; color: var(--primary-bright); font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }\n.hero-title { max-width: 640px; margin: 0; color: var(--ink); font-size: clamp(29px, 3vw, 43px); font-weight: 800; line-height: 1.03; letter-spacing: -.058em; }\n.hero-subcopy { max-width: 600px; margin: 12px 0 0; color: var(--muted); font-size: 13px; line-height: 1.65; }\n.primary-button { display: inline-flex; align-items: center; gap: 9px; flex: 0 0 auto; height: 42px; padding: 0 16px; border: 1px solid rgba(255,255,255,.2); border-radius: 10px; color: #fff; background: linear-gradient(135deg, var(--gold-bright), var(--gold) 65%, #d97706); box-shadow: 0 11px 25px rgba(245,158,11,.18), inset 0 1px 0 rgba(255,255,255,.35); font-size: 11px; font-weight: 800; letter-spacing: .01em; transition: transform .16s ease, box-shadow .16s ease, filter .16s ease; }\n.primary-button:hover { filter: brightness(1.06); box-shadow: 0 14px 30px rgba(245,158,11,.24), inset 0 1px 0 rgba(255,255,255,.35); transform: translateY(-1px); }\n.primary-button.is-pressed { transform: translateY(1px) scale(.965); box-shadow: 0 4px 10px rgba(245,158,11,.12), inset 0 2px 5px rgba(102,55,0,.2); }\n.primary-button svg { width: 15px; height: 15px; }\n\n.hero-grid { display: grid; grid-template-columns: minmax(320px, .85fr) minmax(420px, 1.15fr); gap: 18px; }\n.panel { position: relative; border: 1px solid var(--line); border-radius: 17px; background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.018)); box-shadow: var(--shadow-soft); }\n.shell[data-theme=\"light\"] .panel { background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(247,243,252,.82)); }\n.panel-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; }\n.panel-kicker { margin: 0 0 5px; color: var(--faint); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }\n.panel-title { margin: 0; color: var(--ink); font-size: 16px; font-weight: 800; letter-spacing: -.035em; }\n.panel-meta { color: var(--muted); font-size: 10px; }\n\n.health-panel { min-height: 300px; padding: 23px 24px 20px; overflow: hidden; }\n.health-panel::before { content: ''; position: absolute; top: -70px; right: -35px; width: 180px; height: 180px; border-radius: 50%; background: rgba(124,58,237,.12); filter: blur(30px); pointer-events: none; }\n.health-value-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 15px; margin-top: 29px; }\n.health-number { margin: 0; color: var(--ink); font-size: clamp(35px, 4vw, 56px); font-weight: 800; line-height: .93; letter-spacing: -.07em; }\n.health-number span { display: block; margin-top: 9px; color: var(--muted); font-size: 11px; font-weight: 500; letter-spacing: 0; }\n.trend-pill { display: inline-flex; align-items: center; gap: 4px; margin-bottom: 2px; padding: 5px 8px; border: 1px solid rgba(73,215,166,.2); border-radius: 999px; color: var(--green); background: var(--green-soft); font-size: 10px; font-weight: 800; }\n.trend-pill svg { width: 12px; height: 12px; }\n.health-chart { position: relative; height: 91px; margin-top: 20px; border-bottom: 1px solid var(--line-soft); }\n.health-chart::before, .health-chart::after { content: ''; position: absolute; left: 0; right: 0; height: 1px; background: var(--line-soft); }\n.health-chart::before { top: 25px; } .health-chart::after { top: 57px; }\n.health-chart svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }\n.health-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }\n.health-foot-copy { color: var(--muted); font-size: 10px; }\n.health-foot-copy strong { color: var(--ink-2); font-weight: 700; }\n.health-foot-stat { color: var(--primary-bright); font-size: 11px; font-weight: 800; }\n\n.card-stage { position: relative; min-height: 300px; padding: 20px; overflow: hidden; border: 1px solid rgba(155,107,255,.22); border-radius: 17px; background: radial-gradient(circle at 84% 16%, rgba(245,158,11,.14), transparent 28%), radial-gradient(circle at 20% 104%, rgba(124,58,237,.3), transparent 36%), linear-gradient(130deg, #120a24, #251342 50%, #0b0715); box-shadow: 0 20px 60px rgba(23,7,45,.44), inset 0 1px 0 rgba(255,255,255,.09); }\n.shell[data-theme=\"light\"] .card-stage { background: radial-gradient(circle at 84% 16%, rgba(245,158,11,.16), transparent 28%), radial-gradient(circle at 20% 104%, rgba(124,58,237,.16), transparent 36%), linear-gradient(130deg, #f2eafd, #e8dafa 52%, #fdfbff); }\n.card-stage::after { content: ''; position: absolute; width: 310px; height: 310px; right: -130px; top: -140px; border: 1px solid rgba(255,255,255,.11); border-radius: 50%; box-shadow: 0 0 0 24px rgba(255,255,255,.025), 0 0 0 48px rgba(255,255,255,.018); pointer-events: none; }\n.card-stage-top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }\n.card-stage-label { color: rgba(255,255,255,.65); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n.shell[data-theme=\"light\"] .card-stage-label { color: var(--muted); }\n.card-stage-link { color: var(--gold-bright); font-size: 10px; font-weight: 700; }\n.loyalty-card { position: relative; z-index: 1; min-height: 211px; margin: 22px auto 0; padding: 20px 23px; overflow: hidden; border: 1px solid rgba(255,255,255,.22); border-radius: 16px; background: linear-gradient(120deg, rgba(124,58,237,.86) 0%, rgba(76,29,149,.95) 43%, rgba(20,9,40,.98) 100%); box-shadow: 0 25px 38px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.25), inset -22px -20px 60px rgba(0,0,0,.22); transform: rotate(-1.15deg); transition: transform .35s ease, box-shadow .35s ease; }\n.loyalty-card:hover { transform: rotate(0deg) translateY(-3px); box-shadow: 0 31px 45px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.25), inset -22px -20px 60px rgba(0,0,0,.22); }\n.loyalty-card::before { content: ''; position: absolute; width: 240px; height: 240px; right: -90px; bottom: -130px; border: 1px solid rgba(255,255,255,.16); border-radius: 50%; box-shadow: 0 0 0 20px rgba(255,255,255,.035), 0 0 0 40px rgba(255,255,255,.025); }\n.loyalty-card::after { content: ''; position: absolute; left: -28px; top: 43px; width: 135%; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.17), transparent); transform: rotate(28deg); }\n.card-topline { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }\n.card-brand { color: #fff; font-size: 12px; font-weight: 800; letter-spacing: .15em; }\n.card-tier { display: inline-flex; align-items: center; gap: 5px; color: #ffe5a7; font-size: 9px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }\n.card-tier-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold-bright); box-shadow: 0 0 0 3px rgba(255,200,87,.16), 0 0 14px rgba(255,200,87,.65); }\n.card-mid { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 27px; }\n.card-chip { width: 45px; height: 34px; border: 1px solid rgba(255,255,255,.36); border-radius: 8px; background: linear-gradient(135deg, #fff1b3, #e5a321 42%, #98600d); box-shadow: inset 0 1px 3px rgba(255,255,255,.6), 0 6px 15px rgba(0,0,0,.18); }\n.card-chip::before { content: ''; display: block; width: 22px; height: 20px; margin: 6px auto; border: 1px solid rgba(95,49,0,.42); border-radius: 4px; background: linear-gradient(90deg, transparent 45%, rgba(95,49,0,.35) 46% 51%, transparent 52%), linear-gradient(0deg, transparent 43%, rgba(95,49,0,.35) 44% 51%, transparent 52%); }\n.card-qr { display: grid; grid-template-columns: repeat(5, 5px); grid-template-rows: repeat(5, 5px); gap: 2px; padding: 7px; border: 1px solid rgba(255,255,255,.2); border-radius: 7px; background: rgba(7,2,18,.25); }\n.card-qr span { width: 5px; height: 5px; border-radius: 1px; background: rgba(255,255,255,.8); }\n.card-qr span.off { opacity: .15; }\n.card-bottom { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: space-between; gap: 15px; margin-top: 26px; }\n.card-member-label { margin: 0 0 3px; color: rgba(255,255,255,.52); font-size: 8px; letter-spacing: .15em; text-transform: uppercase; }\n.card-member { margin: 0; color: #fff; font-size: 15px; font-weight: 700; letter-spacing: .06em; }\n.card-stamps { text-align: right; }\n.card-stamps-number { margin: 0; color: #fff; font-size: 26px; font-weight: 800; line-height: .9; letter-spacing: -.07em; }\n.card-stamps-number span { color: rgba(255,255,255,.55); font-size: 13px; letter-spacing: -.02em; }\n.card-stamps-label { margin: 5px 0 0; color: #ffe5a7; font-size: 8px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }\n.card-note { position: relative; z-index: 1; display: flex; align-items: center; gap: 7px; margin: 17px 0 0 3px; color: rgba(255,255,255,.61); font-size: 10px; }\n.card-note svg { width: 13px; height: 13px; color: var(--gold-bright); }\n\n.below-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, .9fr); gap: 18px; margin-top: 18px; }\n.pulse-panel { min-height: 308px; padding: 22px 24px 17px; }\n.pulse-summary { display: flex; align-items: center; gap: 28px; margin-top: 18px; }\n.pulse-big { margin: 0; color: var(--ink); font-size: 28px; font-weight: 800; letter-spacing: -.06em; }\n.pulse-big span { margin-left: 5px; color: var(--green); font-size: 11px; font-weight: 800; letter-spacing: 0; }\n.pulse-summary-label { margin: 2px 0 0; color: var(--muted); font-size: 10px; }\n.pulse-divider { width: 1px; height: 28px; background: var(--line); }\n.pulse-secondary { margin: 0; color: var(--ink-2); font-size: 17px; font-weight: 800; letter-spacing: -.04em; }\n.pulse-secondary-label { margin: 2px 0 0; color: var(--muted); font-size: 10px; }\n.chart-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 20px; }\n.legend { display: flex; align-items: center; gap: 14px; color: var(--muted); font-size: 10px; }\n.legend-item { display: inline-flex; align-items: center; gap: 6px; }\n.legend-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--primary-bright); box-shadow: 0 0 10px rgba(155,107,255,.65); }\n.legend-dot.gold { background: var(--gold); box-shadow: 0 0 10px rgba(245,158,11,.48); }\n.range-pills { display: flex; align-items: center; gap: 4px; }\n.range-pill { height: 27px; padding: 0 9px; border: 1px solid transparent; border-radius: 7px; color: var(--faint); background: transparent; font-size: 10px; font-weight: 700; transition: background .2s ease, border-color .2s ease, color .2s ease; }\n.range-pill:hover { color: var(--ink-2); background: var(--primary-faint); }\n.range-pill[data-active=\"true\"] { color: #fff; border-color: rgba(155,107,255,.32); background: var(--primary); box-shadow: 0 5px 15px rgba(124,58,237,.25); }\n.shell[data-theme=\"light\"] .range-pill[data-active=\"true\"] { color: #fff; }\n.pulse-chart { position: relative; height: 133px; margin-top: 10px; }\n.pulse-chart-grid { position: absolute; inset: 0 0 18px; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }\n.pulse-chart-grid span { width: 100%; height: 1px; background: var(--line-soft); }\n.pulse-svg { position: absolute; inset: 0 0 18px; width: 100%; height: calc(100% - 18px); overflow: visible; }\n.chart-axis { position: absolute; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-between; color: var(--faint); font-size: 9px; }\n.chart-marker { position: absolute; top: 6px; bottom: 18px; left: 69%; width: 1px; border-left: 1px dashed rgba(245,158,11,.6); }\n.chart-marker::after { content: ''; position: absolute; top: 22px; left: -3px; width: 7px; height: 7px; border: 2px solid var(--surface); border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 3px rgba(245,158,11,.16), 0 0 18px rgba(245,158,11,.52); }\n.chart-marker-label { position: absolute; top: -2px; left: calc(69% - 35px); padding: 3px 6px; border: 1px solid rgba(245,158,11,.18); border-radius: 5px; color: var(--gold-bright); background: var(--gold-soft); font-size: 8px; font-weight: 700; white-space: nowrap; }\n\n.rewards-panel { padding: 22px 20px 13px; }\n.reward-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; padding: 0 3px 10px; }\n.reward-manage { border: 0; color: var(--primary-bright); background: transparent; font-size: 10px; font-weight: 700; }\n.reward-list { display: flex; flex-direction: column; }\n.reward-row { display: grid; grid-template-columns: 29px minmax(0,1fr) auto; align-items: center; gap: 10px; min-height: 61px; padding: 10px 3px; border-top: 1px solid var(--line-soft); }\n.reward-row.is-next { margin: 0 -8px; padding-right: 11px; padding-left: 11px; border: 1px solid rgba(245,158,11,.2); border-radius: 11px; background: linear-gradient(90deg, rgba(245,158,11,.08), transparent); }\n.reward-icon { display: grid; place-items: center; width: 29px; height: 29px; border: 1px solid var(--line); border-radius: 9px; color: var(--muted); background: var(--surface-2); }\n.reward-icon svg { width: 15px; height: 15px; }\n.reward-row.is-next .reward-icon { border-color: rgba(245,158,11,.35); color: var(--gold-bright); background: var(--gold-soft); }\n.reward-name { margin: 0; color: var(--ink-2); font-size: 11px; font-weight: 700; }\n.reward-meta { margin: 3px 0 0; color: var(--faint); font-size: 9px; }\n.reward-value { align-self: start; padding-top: 1px; color: var(--muted); font-size: 10px; font-weight: 700; white-space: nowrap; }\n.reward-row.is-next .reward-value { color: var(--gold-bright); }\n.reward-progress { grid-column: 2 / 4; height: 4px; margin-top: -3px; overflow: hidden; border-radius: 999px; background: var(--line); }\n.reward-progress-fill { width: var(--progress); height: 100%; border-radius: inherit; background: var(--primary); }\n.reward-row.is-next .reward-progress-fill { background: linear-gradient(90deg, var(--gold), var(--gold-bright)); box-shadow: 0 0 10px rgba(245,158,11,.45); }\n\n.activity-panel { margin-top: 18px; padding: 21px 24px 10px; }\n.activity-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.activity-head .eyebrow { margin-bottom: 5px; }\n.activity-view { display: inline-flex; align-items: center; gap: 5px; color: var(--primary-bright); font-size: 10px; font-weight: 700; }\n.activity-view svg { width: 13px; height: 13px; }\n.activity-table { width: 100%; }\n.activity-row { display: grid; grid-template-columns: minmax(185px, 1.2fr) minmax(190px, 1.35fr) 90px 80px 90px 85px; align-items: center; gap: 14px; min-height: 61px; border-top: 1px solid var(--line-soft); }\n.activity-row.header { min-height: 30px; border-top: 0; color: var(--faint); font-size: 9px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n.activity-row:not(.header) { color: var(--ink-2); font-size: 11px; }\n.customer-cell { display: flex; align-items: center; gap: 9px; min-width: 0; }\n.customer-avatar { display: grid; place-items: center; width: 29px; height: 29px; flex: 0 0 29px; border: 1px solid var(--line); border-radius: 9px; color: var(--ink-2); background: linear-gradient(145deg, var(--surface-3), var(--surface-2)); font-size: 9px; font-weight: 800; }\n.customer-avatar.amber { color: #ffdda2; background: linear-gradient(145deg, rgba(245,158,11,.32), rgba(124,58,237,.17)); }\n.customer-avatar.pink { color: #ffc0cc; background: linear-gradient(145deg, rgba(244,63,94,.27), rgba(124,58,237,.17)); }\n.customer-avatar.green { color: #b4ffe5; background: linear-gradient(145deg, rgba(16,185,129,.28), rgba(124,58,237,.17)); }\n.customer-name { overflow: hidden; color: var(--ink); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }\n.activity-action { overflow: hidden; color: var(--muted); text-overflow: ellipsis; white-space: nowrap; }\n.channel-cell { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); }\n.channel-cell svg { width: 13px; height: 13px; color: var(--faint); }\n.points { font-variant-numeric: tabular-nums; font-weight: 800; }\n.points.positive { color: var(--green); }\n.points.negative { color: var(--gold-bright); }\n.time-cell { color: var(--faint); font-size: 10px; }\n.status { display: inline-flex; align-items: center; justify-self: start; gap: 5px; padding: 4px 7px; border-radius: 999px; font-size: 9px; font-weight: 700; }\n.status::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }\n.status.earned { color: var(--green); background: var(--green-soft); }\n.status.redeemed { color: var(--gold-bright); background: var(--gold-soft); }\n\n.statusbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin: 0 38px; padding: 16px 0 18px; border-top: 1px solid var(--line-soft); color: var(--faint); font-size: 10px; }\n.statusbar-left { display: inline-flex; align-items: center; gap: 7px; }\n.system-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--green-soft), 0 0 12px rgba(73,215,166,.45); animation: statusPulse 2.4s ease-in-out infinite; }\n.statusbar strong { color: var(--green); font-weight: 700; }\n.statusbar-right { color: var(--faint); }\n\n.reveal { animation: riseIn .65s cubic-bezier(.16,1,.3,1) both; }\n.reveal.delay-1 { animation-delay: .07s; }\n.reveal.delay-2 { animation-delay: .14s; }\n.reveal.delay-3 { animation-delay: .21s; }\n@keyframes riseIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n@keyframes statusPulse { 0%,100% { opacity: .68; transform: scale(.9); } 50% { opacity: 1; transform: scale(1.08); } }\n\n@media (max-width: 1120px) {\n  .topbar { padding-right: 24px; padding-left: 24px; }\n  .content { padding-right: 24px; padding-left: 24px; }\n  .statusbar { margin-right: 24px; margin-left: 24px; }\n  .profile-name, .profile-role { display: none; }\n  .search-box { width: min(285px, 28vw); }\n  .activity-row { grid-template-columns: minmax(150px, 1.05fr) minmax(160px, 1.25fr) 78px 70px 75px 76px; gap: 10px; }\n}\n\n@media (max-width: 900px) {\n  .app-frame { grid-template-columns: 1fr; }\n  .rail { min-height: auto; padding: 14px 16px 12px; border-right: 0; border-bottom: 1px solid var(--line-soft); }\n  .rail::after { top: auto; right: auto; bottom: -1px; left: 18px; width: 160px; height: 1px; }\n  .rail-brand { padding: 0 4px 13px; }\n  .rail-kicker, .rail-spacer, .rail-mini-card, .rail-version { display: none; }\n  .nav-list { flex-direction: row; gap: 5px; overflow-x: auto; padding-bottom: 1px; }\n  .nav-item { width: auto; min-width: max-content; min-height: 38px; padding: 7px 10px; }\n  .nav-index, .nav-badge { display: none; }\n  .main-shell { min-width: 0; }\n  .hero-grid, .below-grid { grid-template-columns: 1fr; }\n  .search-box { width: min(360px, 39vw); }\n}\n\n@media (max-width: 640px) {\n  .topbar { flex-wrap: wrap; padding: 14px 16px; }\n  .business-switcher { min-width: 0; }\n  .topbar-actions { width: 100%; justify-content: stretch; }\n  .search-box { flex: 1; width: auto; }\n  .theme-toggle-label { display: none; }\n  .content { padding: 26px 16px 9px; }\n  .hero-heading { align-items: flex-start; flex-direction: column; gap: 16px; margin-bottom: 20px; }\n  .hero-title { font-size: 32px; }\n  .primary-button { width: 100%; justify-content: center; }\n  .health-panel, .pulse-panel { padding-right: 18px; padding-left: 18px; }\n  .card-stage { padding: 16px; }\n  .loyalty-card { padding-right: 17px; padding-left: 17px; }\n  .pulse-summary { gap: 17px; }\n  .pulse-big { font-size: 24px; }\n  .chart-toolbar { align-items: flex-start; flex-direction: column; }\n  .activity-panel { padding-right: 14px; padding-left: 14px; overflow: hidden; }\n  .activity-head { padding: 0 5px; }\n  .activity-row { grid-template-columns: minmax(135px, 1.15fr) minmax(130px, 1fr) 68px; gap: 9px; }\n  .activity-row.header { display: none; }\n  .activity-row:not(.header) { position: relative; min-height: 76px; padding: 11px 5px; }\n  .activity-row:not(.header) > :nth-child(3) { grid-column: 3; grid-row: 1; }\n  .activity-row:not(.header) > :nth-child(4) { grid-column: 2; grid-row: 2; }\n  .activity-row:not(.header) > :nth-child(5) { grid-column: 3; grid-row: 2; justify-self: end; }\n  .activity-row:not(.header) > :nth-child(6) { position: absolute; top: 12px; right: 5px; }\n  .time-cell { display: none; }\n  .statusbar { align-items: flex-start; flex-direction: column; margin-right: 16px; margin-left: 16px; padding-top: 13px; }\n}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"shell wrapper\" data-theme=\"dark\" id=\"shell\">\n    <div class=\"app-frame\" data-kid=\"1-1\" data-name=\"application frame container\">\n        <aside class=\"rail\" data-kid=\"1-1-1\" data-name=\"sidebar navigation rail\">\n            <div class=\"rail-brand\" data-kid=\"1-1-1-1\" data-name=\"brand identity container\">\n                <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand mark icon container\">\n                    <svg data-kid=\"1-1-1-1-1-1\" data-name=\"shield loyalty icon\" fill=\"none\" height=\"20\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"color:#fff\" viewbox=\"0 0 24 24\" width=\"20\">\n                        <path d=\"M12 3 5 7v6c0 4 2.8 6.8 7 8 4.2-1.2 7-4 7-8V7l-7-4Z\">\n                        </path>\n                        <path d=\"m9 12 2 2 4-4\">\n                        </path>\n                    </svg>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand name and meta container\">\n                    <p class=\"brand-word\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        perkly\n                    </p>\n                    <p class=\"brand-meta\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand meta subtitle text\">\n                        loyalty os\n                    </p>\n                </div>\n            </div>\n            <p class=\"rail-kicker\" data-kid=\"1-1-1-2\" data-name=\"sidebar kicker label\">\n                Workspace\n            </p>\n            <nav aria-label=\"Primary navigation\" class=\"nav-list\" data-kid=\"1-1-1-3\" data-name=\"primary navigation list\">\n                <button aria-current=\"page\" class=\"nav-item is-active\" data-kid=\"1-1-1-3-1\" data-name=\"overview navigation item\" type=\"button\">