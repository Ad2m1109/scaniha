-2-1-2-4-1\">\n                                            <div class=\"customer-cell\" data-kid=\"1-2-2-2-3-1-2-1-2-4-1-1\">\n                                                <span class=\"customer-mini-avatar gold\" data-kid=\"1-2-2-2-3-1-2-1-2-4-1-1-1\">\n                                                    JP\n                                                </span>\n                                                Jon Park\n                                            </div>\n                                        </td>\n                                        <td data-kid=\"1-2-2-2-3-1-2-1-2-4-2\">\n                                            Jun 01, 11:46 AM\n                                        </td>\n                                        <td data-kid=\"1-2-2-2-3-1-2-1-2-4-3\">\n                                            <span class=\"table-number\" data-kid=\"1-2-2-2-3-1-2-1-2-4-3-1\">\n                                                6\n                                            </span>\n                                        </td>\n                                        <td data-kid=\"1-2-2-2-3-1-2-1-2-4-4\">\n                                            <span class=\"table-number\" data-kid=\"1-2-2-2-3-1-2-1-2-4-4-1\">\n                                                620\n                                            </span>\n                                        </td>\n                                        <td data-kid=\"1-2-2-2-3-1-2-1-2-4-5\">\n                                            <span class=\"tier bronze\" data-kid=\"1-2-2-2-3-1-2-1-2-4-5-1\">\n                                                Bronze\n                                            </span>\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                    </section>\n                    <aside class=\"surface-card activity-rail\" data-kid=\"1-2-2-2-3-2\">\n                        <div class=\"card-header\" data-kid=\"1-2-2-2-3-2-1\">\n                            <div data-kid=\"1-2-2-2-3-2-1-1\">\n                                <h2 data-kid=\"1-2-2-2-3-2-1-1-1\">\n                                    Recent activity\n                                </h2>\n                                <p data-kid=\"1-2-2-2-3-2-1-1-2\">\n                                    Last 60 minutes\n                                </p>\n                            </div>\n                            <i class=\"icon-sm\" data-kid=\"1-2-2-2-3-2-1-2\" data-lucide=\"ellipsis\" style=\"color:var(--faint)\">\n                            </i>\n                        </div>\n                        <div class=\"activity-list\" data-kid=\"1-2-2-2-3-2-2\">\n                            <div class=\"activity-row\" data-kid=\"1-2-2-2-3-2-2-1\">\n                                <span class=\"activity-icon gold\" data-kid=\"1-2-2-2-3-2-2-1-1\">\n                                    <i class=\"icon-xs\" data-kid=\"1-2-2-2-3-2-2-1-1-1\" data-lucide=\"gift\">\n                                    </i>\n                                </span>\n                                <div class=\"activity-copy\" data-kid=\"1-2-2-2-3-2-2-1-2\">\n                                    <p data-kid=\"1-2-2-2-3-2-2-1-2-1\">\n                                        <strong data-kid=\"1-2-2-2-3-2-2-1-2-1-1\">\n                                            Maya K.\n                                        </strong>\n                                        claimed a free oat latte\n                                    </p>\n                                    <time data-kid=\"1-2-2-2-3-2-2-1-2-2\">\n                                        2 min ago · 120 pts\n                                    </time>\n                                </div>\n                            </div>\n                            <div class=\"activity-row\" data-kid=\"1-2-2-2-3-2-2-2\">\n                                <span class=\"activity-icon\" data-kid=\"1-2-2-2-3-2-2-2-1\">\n                                    <i class=\"icon-xs\" data-kid=\"1-2-2-2-3-2-2-2-1-1\" data-lucide=\"plus\">\n                                    </i>\n                                </span>\n                                <div class=\"activity-copy\" data-kid=\"1-2-2-2-3-2-2-2-2\">\n                                    <p data-kid=\"1-2-2-2-3-2-2-2-2-1\">\n                                        <strong data-kid=\"1-2-2-2-3-2-2-2-2-1-1\">\n                                            Sarah Khelil\n                                        </strong>\n                                        earned points\n                                    </p>\n                                    <time data-kid=\"1-2-2-2-3-2-2-2-2-2\">\n                                        15 min ago · 50 pts\n                                    </time>\n                                </div>\n                            </div>\n                            <div class=\"activity-row\" data-kid=\"1-2-2-2-3-2-2-3\">\n                                <span class=\"activity-icon sage\" data-kid=\"1-2-2-2-3-2-2-3-1\">\n                                    <i class=\"icon-xs\" data-kid=\"1-2-2-2-3-2-2-3-1-1\" data-lucide=\"scan-line\">\n                                    </i>\n                                </span>\n                                <div class=\"activity-copy\" data-kid=\"1-2-2-2-3-2-2-3-2\">\n                                    <p data-kid=\"1-2-2-2-3-2-2-3-2-1\">\n                                        <strong data-kid=\"1-2-2-2-3-2-2-3-2-1-1\">\n                                            Karim Boudia\n                                        </strong>\n                                        scanned the card\n                                    </p>\n                                    <time data-kid=\"1-2-2-2-3-2-2-3-2-2\">\n                                        1 hr ago · 1 visit\n                                    </time>\n                                </div>\n                            </div>\n                        </div>\n                    </aside>\n                </div>\n                <div class=\"footer-note\" data-kid=\"1-2-2-2-4\">\n                    <span data-kid=\"1-2-2-2-4-1\">\n                        <i class=\"icon-xs\" data-kid=\"1-2-2-2-4-1-1\" data-lucide=\"shield-check\">\n                        </i>\n                        All program data is mock data for preview\n                    </span>\n                    <span data-kid=\"1-2-2-2-4-2\">\n                        Synced just now ·\n                        <span class=\"mono\" data-kid=\"1-2-2-2-4-2-1\">\n                            Northstar / live\n                        </span>\n                    </span>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const dashboard = document.querySelector('[data-dashboard]');\n  if (window.lucide) window.lucide.createIcons();\n\n  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {\n    dashboard.classList.toggle('dark-mode');\n  });\n\n  document.querySelectorAll('[data-range]').forEach((button) => {\n    button.addEventListener('click', () => {\n      document.querySelectorAll('[data-range]').forEach((item) => item.classList.remove('active'));\n      button.classList.add('active');\n      const period = button.getAttribute('data-period');\n      const periodLabel = document.querySelector('.chart-period');\n      if (periodLabel) periodLabel.textContent = period;\n      const line = document.querySelector('[data-chart-line]');\n      const area = document.querySelector('[data-chart-area]');\n      const paths = {\n        '7': 'M0 181 C55 177 85 192 127 151 C171 108 207 134 253 111 C303 86 336 107 376 83 C418 56 462 76 498 54 C542 28 583 55 622 38 C660 21 688 35 720 16',\n        '30': 'M0 188 C42 181 63 190 93 164 C124 139 145 152 177 137 C213 120 234 136 262 114 C293 90 320 112 349 96 C381 77 402 98 431 78 C462 57 487 74 516 57 C548 38 571 54 598 43 C628 31 661 49 720 20',\n        '90': 'M0 197 C35 188 60 191 94 177 C127 163 154 169 190 143 C230 116 253 145 288 125 C328 100 351 112 389 97 C431 80 449 94 491 69 C530 45 563 70 603 51 C638 33 676 45 720 27',\n        '365': 'M0 202 C33 198 66 193 98 186 C134 178 161 183 193 160 C227 136 256 154 291 139 C326 125 349 131 386 112 C423 93 456 110 492 82 C529 54 562 73 600 60 C640 45 679 56 720 32'\n      };\n      const nextLine = paths[button.getAttribute('data-range')];\n      if (line && area && nextLine) {\n        line.setAttribute('d', nextLine);\n        area.setAttribute('d', nextLine + ' L720 219 L0 219 Z');\n      }\n    });\n  });\n\n  document.querySelector('[data-date-control]')?.addEventListener('click', (event) => {\n    const button = event.currentTarget;\n    button.classList.toggle('active');\n    button.style.borderColor = button.classList.contains('active') ? 'var(--primary)' : '';\n    button.style.background = button.classList.contains('active') ? 'var(--primary-soft)' : '';\n  });\n</script>\n",
