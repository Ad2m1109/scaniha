    "var_04504c24f82f": {
      "type": "variant",
      "label": "Loyalty Dashboard — Luminous Glass",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap');\n\n  #perkly-app {\n    --page-bg: #f8f7ff;\n    --surface: rgba(255, 255, 255, .72);\n    --surface-solid: #ffffff;\n    --surface-soft: rgba(255, 255, 255, .48);\n    --purple: #7C3AED;\n    --purple-dark: #5B21B6;\n    --purple-soft: #F0EAFF;\n    --purple-wash: rgba(124, 58, 237, .10);\n    --gold: #F59E0B;\n    --gold-soft: #FFF4D7;\n    --ink: #25183D;\n    --muted: #736B84;\n    --faint: #A9A1B9;\n    --line: rgba(100, 79, 144, .14);\n    --line-strong: rgba(100, 79, 144, .22);\n    --success: #0F9F82;\n    --shadow: 0 18px 42px rgba(75, 49, 129, .10), 0 2px 8px rgba(75, 49, 129, .04);\n    --shadow-soft: 0 10px 26px rgba(75, 49, 129, .08);\n    --radius-card: 22px;\n    min-height: 100vh;\n    background:\n      radial-gradient(circle at 78% -12%, rgba(196, 175, 255, .32), transparent 27rem),\n      radial-gradient(circle at 14% 84%, rgba(245, 158, 11, .08), transparent 24rem),\n      var(--page-bg);\n    color: var(--ink);\n    font-family: 'Geist', Inter, ui-sans-serif, system-ui, sans-serif;\n    letter-spacing: -.012em;\n  }\n\n  #perkly-app[data-theme='dark'] {\n    --page-bg: #120D21;\n    --surface: rgba(36, 26, 61, .72);\n    --surface-solid: #211738;\n    --surface-soft: rgba(52, 36, 84, .60);\n    --purple-soft: rgba(124, 58, 237, .20);\n    --purple-wash: rgba(167, 139, 250, .13);\n    --ink: #F7F3FF;\n    --muted: #B8AEC9;\n    --faint: #877A9F;\n    --line: rgba(218, 204, 255, .13);\n    --line-strong: rgba(218, 204, 255, .24);\n    --shadow: 0 20px 44px rgba(0, 0, 0, .30), 0 2px 8px rgba(0, 0, 0, .18);\n    --shadow-soft: 0 12px 30px rgba(0, 0, 0, .22);\n    background:\n      radial-gradient(circle at 75% -12%, rgba(91, 33, 182, .36), transparent 28rem),\n      radial-gradient(circle at 14% 84%, rgba(245, 158, 11, .07), transparent 24rem),\n      var(--page-bg);\n  }\n\n  #perkly-app .glass {\n    background: var(--surface);\n    border: 1px solid var(--line);\n    box-shadow: var(--shadow);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n  }\n\n  #perkly-app .soft-glass {\n    background: var(--surface-soft);\n    border: 1px solid var(--line);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n  }\n\n  #perkly-app .text-ink { color: var(--ink); }\n  #perkly-app .text-muted { color: var(--muted); }\n  #perkly-app .text-faint { color: var(--faint); }\n  #perkly-app .border-line { border-color: var(--line); }\n  #perkly-app .hover-lift { transition: transform .26s ease, box-shadow .26s ease, border-color .26s ease, background-color .26s ease; }\n  #perkly-app .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 20px 42px rgba(75, 49, 129, .14), 0 3px 10px rgba(75, 49, 129, .06); border-color: rgba(124, 58, 237, .28); }\n  #perkly-app .nav-link { transition: color .22s ease, background-color .22s ease, transform .22s ease; }\n  #perkly-app .nav-link:hover { color: var(--ink); background: var(--purple-wash); transform: translateX(2px); }\n  #perkly-app .nav-link[data-active='true'] { color: var(--purple); background: var(--purple-soft); box-shadow: inset 3px 0 0 var(--purple); }\n  #perkly-app[data-theme='dark'] .nav-link[data-active='true'] { color: #C4B5FD; }\n  #perkly-app .icon-button { transition: transform .22s ease, background-color .22s ease, border-color .22s ease; }\n  #perkly-app .icon-button:hover { transform: translateY(-1px); background: var(--purple-wash); border-color: rgba(124, 58, 237, .25); }\n  #perkly-app .stat-accent { transition: transform .25s ease; transform-origin: left center; }\n  #perkly-app .stat-card:hover .stat-accent { transform: scaleX(1.12); }\n  #perkly-app .hero-card { background: linear-gradient(118deg, #5B21B6 0%, #7C3AED 43%, #4F46E5 100%); box-shadow: 0 24px 48px rgba(91, 33, 182, .24); }\n  #perkly-app .hero-card::before { content: ''; position: absolute; width: 420px; height: 420px; border: 1px solid rgba(255,255,255,.15); border-radius: 50%; right: -120px; top: -218px; box-shadow: 0 0 0 42px rgba(255,255,255,.035), 0 0 0 86px rgba(255,255,255,.028); }\n  #perkly-app .hero-card::after { content: ''; position: absolute; width: 180px; height: 180px; border-radius: 42px; right: 38%; bottom: -120px; background: rgba(255,255,255,.06); transform: rotate(28deg); }\n  #perkly-app .chart-grid { stroke: var(--line); stroke-width: 1; stroke-dasharray: 3 7; }\n  #perkly-app .range-btn { color: var(--muted); transition: background-color .22s ease, color .22s ease, box-shadow .22s ease; }\n  #perkly-app .range-btn[data-active='true'] { color: var(--purple); background: var(--purple-soft); box-shadow: 0 3px 10px rgba(124, 58, 237, .10); }\n  #perkly-app[data-theme='dark'] .range-btn[data-active='true'] { color: #DDD6FE; }\n  #perkly-app .mobile-menu-panel { display: none; }\n  #perkly-app[data-mobile-open='true'] .mobile-menu-panel { display: block; }\n  #perkly-app .stamp { width: 20px; height: 20px; border-radius: 999px; border: 1px solid rgba(255,255,255,.45); display: grid; place-items: center; }\n  #perkly-app .stamp.is-filled { background: var(--gold); border-color: var(--gold); box-shadow: 0 3px 8px rgba(245,158,11,.32); }\n  #perkly-app .stamp.is-empty { background: rgba(255,255,255,.10); }\n  #perkly-app .loyalty-card { background: linear-gradient(135deg, #4C1D95 0%, #7C3AED 50%, #4338CA 100%); box-shadow: 0 24px 36px rgba(76, 29, 149, .26); }\n  #perkly-app .loyalty-card::after { content: ''; position: absolute; width: 210px; height: 210px; border-radius: 50%; border: 1px solid rgba(255,255,255,.17); right: -44px; top: -60px; box-shadow: 0 0 0 20px rgba(255,255,255,.04), 0 0 0 54px rgba(255,255,255,.035); }\n  #perkly-app .reveal { animation: perkly-reveal .58s ease both; }\n  #perkly-app .reveal-delay-1 { animation-delay: .06s; }\n  #perkly-app .reveal-delay-2 { animation-delay: .12s; }\n  #perkly-app .reveal-delay-3 { animation-delay: .18s; }\n  #perkly-app .reveal-delay-4 { animation-delay: .24s; }\n  @keyframes perkly-reveal { from { opacity: 0; transform: translateY(9px); } to { opacity: 1; transform: translateY(0); } }\n  @media (max-width: 1023px) {\n    #perkly-app .desktop-sidebar { display: none; }\n    #perkly-app .mobile-menu-panel { position: absolute; top: 74px; left: 16px; right: 16px; z-index: 50; }\n  }\n  @media (max-width: 639px) {\n    #perkly-app .hero-card::before { right: -240px; }\n    #perkly-app .hero-card::after { right: -40px; }\n  }\n</style>\n<div class=\"min-h-screen\" data-dynamic=\"true\" data-kid=\"1\" data-mobile-open=\"false\" data-name=\"perkly app root\" data-reason=\"data-theme and data-mobile-open attributes managed by script\" data-theme=\"light\" id=\"perkly-app\">\n    <div class=\"mx-auto grid min-h-screen max-w-[1540px] lg:grid-cols-[246px_minmax(0,1fr)]\" data-kid=\"1-1\">\n        <aside class=\"desktop-sidebar hidden border-r border-line px-5 py-6 lg:flex lg:flex-col\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3 px-2\" data-kid=\"1-1-1-1\">\n                <div class=\"relative grid h-10 w-10 place-items-center rounded-[14px] bg-gradient-to-br from-violet-600 via-purple-600 to-indigo-600 text-white shadow-[0_8px_18px_rgba(124,58,237,.28)]\" data-kid=\"1-1-1-1-1\">\n                    <span class=\"absolute inset-[5px] rounded-[10px] border border-white/25\" data-kid=\"1-1-1-1-1-1\">\n                    </span>\n                    <i aria-hidden=\"true\" class=\"relative h-5 w-5 text-white\" data-kid=\"1-1-1-1-1-2\" data-lucide=\"sparkles\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"text-[17px] font-bold leading-none tracking-[-.04em] text-ink\" data-kid=\"1-1-1-1-2-1\">\n                        Perkly\n                    </p>\n                    <p class=\"mt-1 text-[10px] font-semibold uppercase tracking-[.16em] text-muted\" data-kid=\"1-1-1-1-2-2\">\n                        Loyalty studio\n                    </p>\n                </div>\n            </div>\n            <button aria-label=\"Switch business\" class=\"soft-glass mt-8 flex w-full items-center gap-3 rounded-2xl px-3 py-3 text-left hover-lift\" data-kid=\"1-1-1-2\">\n                <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300\" data-kid=\"1-1-1-2-1\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-amber-700 dark:text-amber-300\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"coffee\">\n                    </i>\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2\">\n                    <p class=\"truncate text-xs font-semibold text-ink\" data-kid=\"1-1-1-2-2-1\">\n                        Northstar Coffee\n                    </p>\n                    <p class=\"mt-0.5 text-[11px] text-muted\" data-kid=\"1-1-1-2-2-2\">\n                        Main location\n                    </p>\n                </div>\n                <i aria-hidden=\"true\" class=\"h-4 w-4 shrink-0 text-faint\" data-kid=\"1-1-1-2-3\" data-lucide=\"chevrons-up-down\">\n                </i>\n            </button>\n            <div class=\"mt-8 px-3 text-[10px] font-bold uppercase tracking-[.18em] text-faint\" data-kid=\"1-1-1-3\">\n                Workspace\n            </div>\n            <nav aria-label=\"Primary navigation\" class=\"mt-3 space-y-1\" data-kid=\"1-1-1-4\">\n                <a class=\"nav-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-[13px] font-semibold text-muted\" data-active=\"true\" data-kid=\"1-1-1-4-1\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"h-[17px] w-[17px] text-purple-600\" data-kid=\"1-1-1-4-1-1\" data-lucide=\"layout-dashboard\">\n                    </i>\n                    <span data-kid=\"1-1-1-4-1-2\">\n                        Dashboard\n                    </spa