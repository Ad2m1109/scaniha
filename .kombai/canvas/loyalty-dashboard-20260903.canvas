  "nodes": {
    "var_c581a9e746cb": {
      "type": "variant",
      "label": "Loyalty Dashboard — Editorial Ledger",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --paper: #fbfaf8;\n    --surface: #ffffff;\n    --surface-soft: #f7f3fb;\n    --surface-warm: #fffaf0;\n    --ink: #221b2c;\n    --ink-soft: #4d4358;\n    --muted: #81778b;\n    --faint: #a9a0b1;\n    --rule: #e4deed;\n    --rule-strong: #d9cde8;\n    --primary: #7C3AED;\n    --primary-deep: #5b21b6;\n    --primary-soft: #f0eaff;\n    --primary-faint: #f8f5ff;\n    --gold: #F59E0B;\n    --gold-deep: #a86200;\n    --gold-soft: #fff4d8;\n    --sage: #17836b;\n    --sage-soft: #e5f5ef;\n    --rose: #bb5571;\n    --shadow-soft: 0 14px 36px rgba(66, 45, 88, .07);\n    --shadow-card: 0 2px 5px rgba(66, 45, 88, .04), 0 14px 35px rgba(66, 45, 88, .055);\n    --radius-lg: 18px;\n    --radius-md: 14px;\n    --radius-sm: 10px;\n    --font-sans: 'Geist', 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  [data-dashboard].dark-mode {\n    --paper: #1d1324;\n    --surface: #27182f;\n    --surface-soft: #30203a;\n    --surface-warm: #35241d;\n    --ink: #fbf7ff;\n    --ink-soft: #d7cbe0;\n    --muted: #aa99b5;\n    --faint: #877793;\n    --rule: #473450;\n    --rule-strong: #5a4167;\n    --primary: #a77bff;\n    --primary-deep: #c0a2ff;\n    --primary-soft: #42265e;\n    --primary-faint: #2b1c36;\n    --gold: #f6b93f;\n    --gold-deep: #ffd477;\n    --gold-soft: #4a321b;\n    --sage: #52c6a4;\n    --sage-soft: #1d453c;\n    --rose: #ee8da5;\n    --shadow-soft: 0 18px 40px rgba(0, 0, 0, .22);\n    --shadow-card: 0 2px 4px rgba(0,0,0,.18), 0 18px 38px rgba(0,0,0,.16);\n  }\n\n  [data-dashboard] {\n    min-height: 100vh;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-sans);\n    font-size: 14px;\n    line-height: 1.45;\n    letter-spacing: -0.01em;\n    -webkit-font-smoothing: antialiased;\n    transition: background-color .35s ease, color .35s ease;\n  }\n\n  [data-dashboard] *, [data-dashboard] *::before, [data-dashboard] *::after { box-sizing: border-box; }\n  [data-dashboard] button, [data-dashboard] a { font: inherit; }\n  [data-dashboard] button { cursor: pointer; }\n  [data-dashboard] a { color: inherit; text-decoration: none; }\n  [data-dashboard] svg { display: block; }\n  .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }\n  .icon { width: 18px; height: 18px; stroke-width: 1.8; flex: 0 0 auto; }\n  .icon-sm { width: 15px; height: 15px; stroke-width: 1.9; flex: 0 0 auto; }\n  .icon-xs { width: 13px; height: 13px; stroke-width: 2; flex: 0 0 auto; }\n\n  .topbar {\n    height: 76px;\n    border-bottom: 1px solid var(--rule);\n    display: flex;\n    align-items: center;\n    gap: 26px;\n    padding: 0 clamp(20px, 3.4vw, 54px);\n    background: color-mix(in srgb, var(--paper) 88%, transparent);\n    position: sticky;\n    top: 0;\n    z-index: 10;\n    backdrop-filter: blur(18px);\n  }\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    flex: 0 0 auto;\n    color: var(--ink);\n    font-size: 20px;\n    font-weight: 700;\n    letter-spacing: -.045em;\n  }\n  .brand-mark {\n    width: 34px;\n    height: 34px;\n    border-radius: 11px;\n    display: grid;\n    place-items: center;\n    color: #fff;\n    background: linear-gradient(145deg, var(--primary) 4%, #5d24b6 100%);\n    box-shadow: 0 7px 16px rgba(124, 58, 237, .25);\n  }\n  .brand-mark .icon { width: 18px; height: 18px; stroke-width: 2.1; }\n  .brand-note {\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    margin: 2px 0 0 1px;\n  }\n  .main-nav {\n    display: flex;\n    align-items: center;\n    gap: 3px;\n    min-width: 0;\n    flex: 0 1 auto;\n  }\n  .nav-link {\n    padding: 9px 11px;\n    border-radius: 999px;\n    color: var(--muted);\n    font-size: 12px;\n    font-weight: 600;\n    white-space: nowrap;\n    transition: color .2s ease, background-color .2s ease;\n  }\n  .nav-link:hover { color: var(--ink); background: var(--surface-soft); }\n  .nav-link.active { color: var(--primary-deep); background: var(--primary-soft); }\n  .top-search {\n    height: 38px;\n    max-width: 250px;\n    min-width: 150px;\n    margin-left: auto;\n    flex: 1 1 190px;\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    padding: 0 13px;\n    border: 1px solid var(--rule);\n    border-radius: 11px;\n    color: var(--faint);\n    background: var(--surface);\n    box-shadow: inset 0 1px 1px rgba(255,255,255,.55);\n  }\n  .top-search span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }\n  .top-actions { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }\n  .icon-button {\n    position: relative;\n    width: 36px;\n    height: 36px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--rule);\n    border-radius: 11px;\n    color: var(--muted);\n    background: var(--surface);\n    transition: color .2s ease, border-color .2s ease, background-color .2s ease, transform .2s ease;\n  }\n  .icon-button:hover { color: var(--primary); border-color: var(--rule-strong); background: var(--primary-faint); transform: translateY(-1px); }\n  .notification-dot {\n    position: absolute;\n    width: 7px;\n    height: 7px;\n    top: 7px;\n    right: 7px;\n    border: 2px solid var(--surface);\n    border-radius: 50%;\n    background: var(--gold);\n  }\n  .account {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    padding-left: 6px;\n    margin-left: 1px;\n  }\n  .avatar {\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    color: #fff;\n    background: linear-gradient(145deg, #8b5cf6, #5b21b6);\n    font-size: 11px;\n    font-weight: 700;\n    box-shadow: 0 0 0 3px var(--primary-soft);\n  }\n  .account-copy { line-height: 1.15; }\n  .account-copy strong { display: block; font-size: 12px; font-weight: 700; }\n  .account-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; }\n\n  .page {\n    width: min(1360px, calc(100% - 64px));\n    margin: 0 auto;\n    padding: 40px 0 62px;\n  }\n  .page-intro {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 24px;\n    margin-bottom: 28px;\n  }\n  .eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--muted);\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .085em;\n    text-transform: uppercase;\n  }\n  .eyebrow-mark { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px var(--gold-soft); }\n  .page-title {\n    margin: 10px 0 6px;\n    color: var(--ink);\n    font-size: clamp(29px, 3vw, 42px);\n    font-weight: 700;\n    letter-spacing: -.065em;\n    line-height: 1.02;\n  }\n  .page-subtitle { margin: 0; color: var(--muted); font-size: 13px; }\n  .business-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    margin-left: 10px;\n    padding: 5px 9px 5px 7px;\n    vertical-align: middle;\n    border: 1px solid var(--rule-strong);\n    border-radius: 999px;\n    color: var(--ink-soft);\n    background: var(--surface);\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\n  .business-badge .badge-dot { width: 19px; height: 19px; display: grid; place-items: center; border-radius: 6px; color: #fff; background: var(--gold); }\n  .business-badge .icon { width: 12px; height: 12px; stroke-width: 2.3; }\n  .intro-actions { display: flex; align-items: center; gap: 9px; padding-bottom: 2px; }\n  .date-control {\n    height: 39px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 0 12px;\n    border: 1px solid var(--rule);\n    border-radius: 10px;\n    color: var(--ink-soft);\n    background: var(--surface);\n    font-size: 12px;\n    font-weight: 600;\n    white-space: nowrap;\n    transition: border-color .2s ease, background-color .2s ease;\n  }\n  .date-control:hover { border-color: var(--primary); background: var(--primary-faint); }\n  .date-control .icon-sm { color: var(--muted); }\n  .primary-button {\n    height: 39px;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 0 15px;\n    border: 0;\n    border-radius: 10px;\n    color: #fff;\n    background: var(--primary);\n    box-shadow: 0 8px 18px rgba(124, 58, 237, .19);\n    font-size: 12px;\n    font-weight: 700;\n    transition: transform .2s ease, background-color .2s ease, box-shadow .2s ease;\n  }\n  .primary-button:hover { background: var(--primary-deep); box-shadow: 0 11px 22px rgba(124, 58, 237, .27); transform: translateY(-1px); }\n  .primary-button .icon-sm { width: 15px; height: 15px; stroke-width: 2.1; }\n\n  .content-grid { display: grid; grid-template-columns: 296px minmax(0, 1fr); align-items: start; gap: 28px; }\n  .feature-panel {\n    padding: 21px;\n    border: 1px solid var(--rule);\n    border-radius: var(--radius-lg);\n    background: var(--surface);\n    box-shadow: var(--shadow-card);\n    animation: rise-in .65s both;\n  }\n  .feature-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 17px; }\n  .section-title { margin: 0; color: var(--ink); font-size: 14px; font-weight: 700; letter-spacing: -.025em; }\n  .section-kicker { margin: 3px 0 0; color: var(--muted); font-size: 11px; }\n  .small-action { width: 29px; height: 29px; display: grid; place-items: center; color: var(--muted); border: 1px solid var(--rule); border-radius: 9px; background: var(--surface); transition: all .2s ease; }\n  .small-action:hover { color: var(--primary); border-color: var(--rule-strong); background: var(--primary-soft); }\n\n  .loyalty-card {\n    position: relative;\n    height: 342px;\n    overflow: hidden;\n    padding: 21px 19px 18px;\n    border-radius: 16px;\n    color: #fff;\n    background: linear-gradient(138deg, #f4efe4 0%, #e9e0f8 38%, #6e36cb 100%);\n    box-shadow: 0 17px 26px rgba(63, 34, 111, .23), inset 0 0 0 1px rgba(255,255,255,.48);\n    isolation: isolate;\n  }\n  .loyalty-card::before, .loyalty-card::after { content: ''; position: absolute; z-index: -1; border-radius: 50%; border: 1px solid rgba(255,255,255,.22); }\n  .loyalty-card::before { width: 225px; height: 225px; right: -88px; top: 62px; box-shadow: 0 0 0 24px rgba(255,255,255,.035), 0 0 0 49px rgba(255,255,255,.032); }\n  .loyalty-card::after { width: 136px; height: 136px; left: -64px; bottom: -43px; border-color: rgba(124,58,237,.22); box-shadow: 0 0 0 22px rgba(124,58,237,.07); }\n  .card-topline { display: flex; align-items: center; justify-content: space-between; color: #49365c; }\n  .card-brand { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }\n  .card-brand .card-mark { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 7px; color: #fff; background: #7c3aed; }\n  .card-brand .icon { width: 12px; height: 12px; stroke-width: 2.4; }\n  .card-type { color: rgba(53, 34, 69, .58); font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n  .card-middle { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 29px; }\n  .member-label { color: rgba(51, 35, 67, .55); font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }\n  .member-name { margin-top: 3px; color: #2c1d3d; font-size: 19px; font-weight: 700; letter-spacing: -.04em; }\n  .member-level { margin-top: 11px; display: flex; align-items: center; gap: 6px; color: #684a79; font-size: 10px; font-weight: 600; }\n  .member-level .icon { width: 12px; height: 12px; color: #9b5ff3; stroke-width: 2.4; }\n  .foil-seal { width: 66px; height: 66px; margin-top: -6px; display: grid; place-items: center; border-radius: 50%; color: #754400; border: 1px solid rgba(139, 82, 0, .28); background: radial-gradient(circle at 32% 26%, #ffeab0, #eeb043 62%, #bc7610); box-shadow: inset 0 0 0 4px rgba(255,244,192,.42), inset 0 0 0 6px rgba(159,94,6,.25), 0 6px 12px rgba(81, 46, 3, .17); transform: rotate(9deg); text-align: center; }\n  .foil-seal strong { display: block; font-size: 10px; line-height: 1; letter-spacing: .08em; text-transform: uppercase; }\n  .foil-seal span { display: block; margin-top: 3px; font-size: 8px; font-weight: 700; }\n  .stamp-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 34px; color: rgba(47, 32, 64, .65); font-size: 10px; font-weight: 700; }\n  .stamp-heading b { color: #5f21b6; font-family: var(--font-mono); font-size: 15px; letter-spacing: -.06em; }\n  .stamps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 10px; padding-right: 30px; }\n  .stamp { width: 31px; height: 31px; display: grid; place-items: center; border: 1px dashed rgba(58,35,73,.32); border-radius: 50%; color: rgba(80,49,100,.38); background: rgba(255,255,255,.17); }\n  .stamp.filled { border: 1px solid rgba(245,158,11,.6); color: #8a5608; background: radial-gradient(circle at 32% 23%, #ffe7a0, #edae32); box-shadow: 0 2px 6px rgba(124,79,7,.13); }\n  .stamp .icon { width: 14px; height: 14px; stroke-width: 2.5; }\n  .card-footer { position: absolute; right: 19px; bottom: 17px; left: 19px; display: flex; align-items: flex-end; justify-content: space-between; }\n  .card-id { color: rgba(46, 31, 61, .55); font-family: var(--font-mono); font-size: 8px; letter-spacing: .08em; }\n  .qr-mark { width: 29px; height: 29px; display: grid; place-items: center; color: #fff; border-radius: 6px; background: rgba(45, 26, 76, .57); }\n  .qr-mark .icon { width: 17px; height: 17px; stroke-width: 1.7; }\n\n  .progress-block { margin-top: 19px; padding-top: 16px; border-top: 1px solid var(--rule); }\n  .progress-copy { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }\n  .progress-copy span { color: var(--muted); font-size: 11px; }\n  .progress-copy strong { color: var(--ink); font-family: var(--font-mono); font-size: 16px; letter-spacing: -.06em; }\n  .progress-track { height: 7px; margin-top: 10px; overflow: hidden; border-radius: 999px; background: var(--primary-soft); }\n  .progress-fill { height: 100%; width: 82%; border-radius: inherit; background: linear-gradient(90deg, var(--primary), #a778ff); }\n  .progress-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; color: var(--faint); font-size: 10px; }\n  .progress-foot .gold-note { display: flex; align-items: center; gap: 5px; color: var(--gold-deep); font-weight: 600; }\n  .gold-note .icon-xs { color: var(--gold); }\n\n  .dashboard-body { min-width: 0; animation: rise-in .65s .08s both; }\n  .metrics-ledger { display: grid; grid-template-columns: minmax(175px, 1.5fr) repeat(4, minmax(118px, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }\n  .metric { min-height: 110px; padding: 17px 19px 15px; border-left: 1px solid var(--rule); }\n  .metric:first-child { border-left: 0; padding-left: 0; }\n  .metric-label { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 11px; font-weight: 600; }\n  .metric-label .icon-xs { color: var(--faint); }\n  .metric-value { margin-top: 10px; color: var(--ink); font-size: 26px; font-weight: 700; letter-spacing: -.065em; line-height: 1; }\n  .metric:first-child .metric-value { font-size: 40px; }\n  .metric-note { display: flex; align-items: center; gap: 5px; margin-top: 9px; color: var(--muted); font-size: 10px; white-space: nowrap; }\n  .delta-up { color: var(--sage); font-family: var(--font-mono); font-weight: 600; }\n  .delta-gold { color: var(--gold-deep); font-family: var(--font-mono); font-weight: 600; }\n  .delta-neutral { color: var(--primary-deep); font-family: var(--font-mono); font-weight: 600; }\n\n  .analysis-grid { display: grid; grid-template-columns: minmax(0, 1fr) 306px; gap: 19px; margin-top: 22px; }\n  .surface-card { border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); }\n  .chart-card { min-width: 0; padding: 20px 21px 16px; }\n  .card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }\n  .card-header h2 { margin: 0; color: var(--ink); font-size: 16px; font-weight: 700; letter-spacing: -.035em; }\n  .card-header p { margin: 4px 0 0; color: var(--muted); font-size: 11px; }\n  .range-controls { display: flex; align-items: center; gap: 2px; padding: 3px; border: 1px solid var(--rule); border-radius: 9px; background: var(--surface-soft); }\n  .range-button { min-width: 31px; height: 25px; padding: 0 7px; border: 0; border-radius: 6px; color: var(--muted); background: transparent; font-family: var(--font-mono); font-size: 10px; font-weight: 600; transition: color .2s ease, background-color .2s ease; }\n  .range-button:hover { color: var(--primary-deep); }\n  .range-button.active { color: var(--primary-deep); background: var(--surface); box-shadow: 0 1px 3px rgba(73,40,105,.09); }\n  .chart-caption { display: flex; align-items: center; gap: 7px; margin-top: 18px; color: var(--muted); font-size: 10px; }\n  .chart-caption .line-key { width: 21px; height: 3px; border-radius: 99px; background: var(--primary); }\n  .chart-caption .dot-key { width: 7px; height: 7px; border: 2px solid var(--surface); border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 1px var(--gold); margin-left: 9px; }\n  .chart-wrap { height: 245px; margin-top: 4px; }\n  .chart-wrap svg { width: 100%; height: 100%; overflow: visible; }\n  .chart-grid-line { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 3 5; }\n  .chart-axis { fill: var(--faint); font-family: var(--font-mono); font-size: 9px; }\n  .chart-area { fill: url(#areaGradient); opacity: .62; }\n  .chart-line { fill: none; stroke: var(--primary); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 3px 3px rgba(124,58,237,.12)); }\n  .chart-dot { fill: var(--gold); stroke: var(--surface); stroke-width: 3; }\n  .chart-dot-small { fill: var(--primary); stroke: var(--surface); stroke-width: 2; }\n  .chart-tooltip { fill: var(--ink); font-family: var(--font-mono); font-size: 9px; font-weight: 600; }\n  .chart-period { color: var(--primary-deep); font-family: var(--font-mono); font-weight: 600; }\n\n  .economics-card { min-width: 0; padding: 20px 21px; background: linear-gradient(145deg, var(--surface) 0%, var(--surface-warm) 100%); }\n  .economics-top { display: flex; align-items: flex-start; justify-content: space-between; }\n  .economics-top .status { display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; color: var(--gold-deep); border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent); border-radius: 999px; background: var(--gold-soft); font-size: 10px; font-weight: 700; }\n  .status .icon-xs { width: 12px; height: 12px; stroke-width: 2.4; }\n  .economics-number { margin-top: 25px; color: var(--ink); font-size: 30px; font-weight: 700; letter-spacing: -.07em; line-height: 1; }\n  .economics-label { margin-top: 6px; color: var(--muted); font-size: 11px; }\n  .ring-row { display: flex; align-items: center; gap: 16px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--rule); }\n  .goal-ring { width: 94px; height: 94px; flex: 0 0 auto; transform: rotate(-90deg); }\n  .ring-track { fill: none; stroke: var(--primary-soft); stroke-width: 8; }\n  .ring-progress { fill: none; stroke: var(--primary); stroke-width: 8; stroke-linecap: round; stroke-dasharray: 214; stroke-dashoffset: 51; }\n  .ring-copy strong { display: block; color: var(--ink); font-size: 22px; font-weight: 700; letter-spacing: -.06em; }\n  .ring-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; line-height: 1.35; }\n  .economics-note { margin: 20px 0 0; padding: 12px 13px; color: var(--ink-soft); border-left: 2px solid var(--gold); background: color-mix(in srgb, var(--gold-soft) 62%, transparent); font-size: 11px; line-height: 1.45; }\n  .economics-note strong { color: var(--gold-deep); font-weight: 700; }\n\n  .momentum-layout { display: grid; grid-template-columns: minmax(0, 1fr) 306px; gap: 19px; margin-top: 22px; }\n  .momentum-card { min-width: 0; padding: 20px 0 0; overflow: hidden; }\n  .momentum-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; padding: 0 21px 17px; }\n  .momentum-title { display: flex; align-items: center; gap: 8px; }\n  .momentum-title .section-kicker { margin: 0; }\n  .tiny-rule { width: 1px; height: 15px; background: var(--rule-strong); }\n  .view-link { display: inline-flex; align-items: center; gap: 6px; color: var(--primary-deep); font-size: 11px; font-weight: 700; white-space: nowrap; transition: gap .2s ease; }\n  .view-link:hover { gap: 9px; }\n  .view-link .icon-xs { width: 13px; height: 13px; }\n  .table-scroll { overflow-x: auto; }\n  .customer-table { width: 100%; min-width: 640px; border-collapse: collapse; }\n  .customer-table th { padding: 10px 15px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); color: var(--faint); font-size: 10px; font-weight: 700; letter-spacing: .045em; text-align: left; text-transform: uppercase; white-space: nowrap; }\n  .customer-table th:first-child, .customer-table td:first-child { padding-left: 21px; }\n  .customer-table th:last-child, .customer-table td:last-child { padding-right: 21px; }\n  .customer-table td { padding: 13px 15px; border-bottom: 1px solid var(--rule); color: var(--ink-soft); font-size: 11px; white-space: nowrap; transition: background-color .2s ease; }\n  .customer-table tbody tr:last-child td { border-bottom: 0; }\n  .customer-table tbody tr:hover td { background: var(--primary-faint); }\n  .customer-cell { display: flex; align-items: center; gap: 9px; color: var(--ink); font-weight: 700; }\n  .customer-mini-avatar { width: 27px; height: 27px; display: grid; place-items: center; border-radius: 50%; color: var(--primary-deep); background: var(--primary-soft); font-size: 9px; font-weight: 700; }\n  .customer-mini-avatar.gold { color: var(--gold-deep); background: var(--gold-soft); }\n  .customer-mini-avatar.sage { color: var(--sage); background: var(--sage-soft); }\n  .table-number { color: var(--ink); font-family: var(--font-mono); font-size: 11px; }\n  .tier { display: inline-flex; align-items: center; gap: 5px; padding: 4px 7px; border-radius: 999px; font-size: 10px; font-weight: 700; }\n  .tier::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }\n  .tier.gold { color: var(--gold-deep); background: var(--gold-soft); }\n  .tier.silver { color: var(--primary-deep); background: var(--primary-soft); }\n  .tier.bronze { color: #a36a44; background: #f7eae0; }\n\n  .activity-rail { min-width: 0; padding: 20px 19px 7px; }\n  .activity-rail .card-header { padding-bottom: 14px; border-bottom: 1px solid var(--rule); }\n  .activity-list { margin-top: 3px; }\n  .activity-row { position: relative; display: grid; grid-template-columns: 29px minmax(0,1fr); gap: 9px; padding: 13px 0; border-bottom: 1px solid var(--rule); }\n  .activity-row:last-child { border-bottom: 0; }\n  .activity-row::before { content: ''; position: absolute; top: 0; bottom: -1px; left: 14px; width: 1px; background: var(--rule-strong); z-index: 0; }\n  .activity-icon { position: relative; z-index: 1; width: 29px; height: 29px; display: grid; place-items: center; border: 4px solid var(--surface); border-radius: 50%; color: var(--primary); background: var(--primary-soft); }\n  .activity-icon.gold { color: var(--gold-deep); background: var(--gold-soft); }\n  .activity-icon.sage { color: var(--sage); background: var(--sage-soft); }\n  .activity-icon .icon-xs { width: 12px; height: 12px; stroke-width: 2.2; }\n  .activity-copy { min-width: 0; padding-top: 1px; }\n  .activity-copy p { overflow: hidden; margin: 0; color: var(--ink-soft); font-size: 10.5px; line-height: 1.38; text-overflow: ellipsis; }\n  .activity-copy strong { color: var(--ink); font-weight: 700; }\n  .activity-copy time { display: block; margin-top: 4px; color: var(--faint); font-family: var(--font-mono); font-size: 9px; }\n\n  .footer-note { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--rule); color: var(--faint); font-size: 10px; }\n  .footer-note span { display: inline-flex; align-items: center; gap: 6px; }\n  .footer-note .icon-xs { color: var(--sage); }\n\n  @keyframes rise-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n  @keyframes pulse-soft { 0%,100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 18%, transparent); } 50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--gold) 0%, transparent); } }\n  .foil-seal { animation: pulse-soft 3.8s ease-in-out infinite; }\n\n  @media (max-width: 1210px) {\n    .topbar { gap: 18px; }\n    .main-nav { overflow-x: auto; scrollbar-width: none; }\n    .main-nav::-webkit-scrollbar { display: none; }\n    .nav-link { padding-inline: 8px; }\n    .metrics-ledger { grid-template-columns: minmax(170px, 1.35fr) repeat(4, minmax(105px, 1fr)); }\n    .metric { padding-inline: 14px; }\n  }\n  @media (max-width: 1040px) {\n    .top-search { max-width: 190px; }\n    .content-grid { grid-template-columns: 260px minmax(0, 1fr); gap: 20px; }\n    .loyalty-card { height: 318px; }\n    .analysis-grid, .momentum-layout { grid-template-columns: minmax(0, 1fr) 270px; gap: 14px; }\n    .metric:first-child .metric-value { font-size: 34px; }\n    .metric-value { font-size: 22px; }\n  }\n  @media (max-width: 860px) {\n    .topbar { height: auto; min-height: 70px; flex-wrap: wrap; padding-block: 13px; }\n    .main-nav { order: 3; width: 100%; flex-basis: 100%; justify-content: space-between; border-top: 1px solid var(--rule); padding-top: 10px; }\n    .top-search { margin-left: auto; }\n    .page { width: min(100% - 32px, 720px); padding-top: 28px; }\n    .page-intro { align-items: flex-start; flex-direction: column; }\n    .intro-actions { width: 100%; justify-content: space-between; }\n    .content-grid { grid-template-columns: 1fr; }\n    .feature-panel { max-width: 430px; }\n    .analysis-grid, .momentum-layout { grid-template-columns: 1fr; }\n    .economics-card, .activity-rail { min-height: 0; }\n    .metrics-ledger { grid-template-columns: repeat(2, 1fr); }\n    .metric:first-child { grid-column: span 2; border-left: 0; }\n    .metric:nth-child(3) { border-left: 0; }\n    .metric:first-child .metric-value { font-size: 38px; }\n  }\n  @media (max-width: 540px) {\n    .topbar { padding-inline: 16px; gap: 12px; }\n    .brand-note, .account-copy, .top-search { display: none; }\n    .top-actions { margin-left: auto; }\n    .page { width: calc(100% - 24px); padding-top: 24px; }\n    .page-title { font-size: 31px; }\n    .business-badge { display: flex; width: max-content; margin: 12px 0 0; }\n    .intro-actions { align-items: stretch; flex-direction: column; }\n    .date-control, .primary-button { justify-content: center; width: 100%; }\n    .feature-panel { padding: 17px; }\n    .metrics-ledger { grid-template-columns: 1fr 1fr; }\n    .metric { min-height: 98px; padding-inline: 12px; }\n    .metric:first-child { grid-column: span 2; padding-left: 0; }\n    .metric:first-child .metric-value { font-size: 36px; }\n    .chart-card, .economics-card { padding-inline: 16px; }\n    .card-header { align-items: flex-start; flex-direction: column; }\n    .range-controls { align-self: flex-start; }\n    .chart-wrap { height: 210px; }\n    .momentum-h